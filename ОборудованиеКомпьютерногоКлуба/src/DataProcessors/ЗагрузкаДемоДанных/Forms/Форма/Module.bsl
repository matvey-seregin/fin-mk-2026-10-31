#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ПутьКФайлу = "D:\edt-ws\fin\ОборудованиеКомпьютерногоКлуба\demo\ДемоДанные.json";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ВывестиСообщение("Укажите путь к файлу с демонстрационными данными.");
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДанныеНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьДанныеНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Итоги = Обработка.ЗагрузитьДанныеИзФайла(ПутьКФайлу);
	
	ВывестиСообщение("Загружено элементов справочников: " + Итоги.Справочники + ".");
	ВывестиСообщение("Загружено записей регистров сведений: " + Итоги.Регистры + ".");
	ВывестиСообщение("Загружено документов: " + Итоги.Документы + ".");
	
	Если Итоги.Ошибки.Количество() > 0 Тогда
		ВывестиСообщение("Загрузка завершена с замечаниями:");
		Для Каждого ТекстОшибки Из Итоги.Ошибки Цикл
			ВывестиСообщение(ТекстОшибки);
		КонецЦикла;
	Иначе
		ВывестиСообщение("Загрузка выполнена без ошибок.");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСообщение(Текст)
	
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = Текст;
	СообщениеПользователю.Сообщить();
	
КонецПроцедуры

#КонецОбласти
