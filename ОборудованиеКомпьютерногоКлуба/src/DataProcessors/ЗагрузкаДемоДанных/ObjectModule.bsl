#Область ПрограммныйИнтерфейс

// Загружает демонстрационные данные из JSON-файла.
//
// Параметры:
//  ПутьКФайлу - Строка - полный путь к файлу демонстрационных данных.
//
// Возвращаемое значение:
//  Структура - итоги загрузки:
//   * Справочники - Число - количество записанных элементов справочников;
//   * Регистры - Число - количество записанных записей регистров сведений;
//   * Документы - Число - количество записанных документов;
//   * Ошибки - Массив из Строка - текст сообщений об ошибках.
//
Функция ЗагрузитьДанныеИзФайла(ПутьКФайлу) Экспорт
	
	Итоги = Новый Структура;
	Итоги.Вставить("Справочники", 0);
	Итоги.Вставить("Регистры", 0);
	Итоги.Вставить("Документы", 0);
	Итоги.Вставить("Ошибки", Новый Массив);
	
	Данные = ПрочитатьФайлДанных(ПутьКФайлу, Итоги);
	Если Данные = Неопределено Тогда
		Возврат Итоги;
	КонецЕсли;
	
	ЗагрузитьСправочники(Данные, Итоги);
	ЗагрузитьРегистрыСведений(Данные, Итоги);
	ЗагрузитьДокументы(Данные, Итоги);
	
	Возврат Итоги;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьФайлДанных(ПутьКФайлу, Итоги)
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьФайл(ПутьКФайлу);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		Итоги.Ошибки.Добавить("Не удалось прочитать файл """ + ПутьКФайлу + """: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Итоги.Ошибки.Добавить("Файл не содержит объекта JSON с корневыми разделами.");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Процедура ЗагрузитьСправочники(Данные, Итоги)
	
	Раздел = Данные.Получить("Справочники");
	Если Раздел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Порядок важен: зависимые справочники загружаются после тех, на которые ссылаются.
	ПорядокЗагрузки = Новый Массив;
	ПорядокЗагрузки.Добавить("Контрагенты");
	ПорядокЗагрузки.Добавить("Сотрудники");
	ПорядокЗагрузки.Добавить("Номенклатура");
	ПорядокЗагрузки.Добавить("РабочиеМеста");
	ПорядокЗагрузки.Добавить("Оборудование");
	ПорядокЗагрузки.Добавить("Лицензии");
	
	Для Каждого ИмяСправочника Из ПорядокЗагрузки Цикл
		Элементы = Раздел.Получить(ИмяСправочника);
		Если Элементы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеСправочника = Метаданные.Справочники.Найти(ИмяСправочника);
		Если МетаданныеСправочника = Неопределено Тогда
			Итоги.Ошибки.Добавить("Неизвестный справочник: " + ИмяСправочника);
			Продолжить;
		КонецЕсли;
		
		Для Каждого ДанныеЭлемента Из Элементы Цикл
			ЗаписатьЭлементСправочника(МетаданныеСправочника, ДанныеЭлемента, Итоги);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЭлементСправочника(МетаданныеСправочника, ДанныеЭлемента, Итоги)
	
	Наименование = ДанныеЭлемента.Получить("Наименование");
	
	Попытка
		Менеджер = Справочники[МетаданныеСправочника.Имя];
		СуществующаяСсылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
		
		ТребуетсяГруппа = Ложь;
		Если МетаданныеСправочника.Иерархический Тогда
			ПризнакГруппы = ДанныеЭлемента.Получить("ЭтоГруппа");
			ТребуетсяГруппа = ?(ПризнакГруппы = Неопределено, Ложь, ПризнакГруппы);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СуществующаяСсылка) Тогда
			Объект = СуществующаяСсылка.ПолучитьОбъект();
			Если Объект.ЭтоГруппа <> ТребуетсяГруппа Тогда
				Итоги.Ошибки.Добавить("Элемент """ + Наименование + """ уже существует с другим видом (группа/элемент), пропущен.");
				Возврат;
			КонецЕсли;
		ИначеЕсли ТребуетсяГруппа Тогда
			// Признак группы у объекта справочника доступен только для чтения, вид задаётся при создании.
			Объект = Менеджер.СоздатьГруппу();
		Иначе
			Объект = Менеджер.СоздатьЭлемент();
		КонецЕсли;
		
		Объект.Наименование = Наименование;
		
		Если МетаданныеСправочника.Иерархический Тогда
			ИмяРодителя = ДанныеЭлемента.Получить("Родитель");
			Если ЗначениеЗаполнено(ИмяРодителя) Тогда
				РодительСсылка = Менеджер.НайтиПоНаименованию(ИмяРодителя, Истина);
				Если ЗначениеЗаполнено(РодительСсылка) Тогда
					Объект.Родитель = РодительСсылка;
				Иначе
					Итоги.Ошибки.Добавить("Не найден родитель """ + ИмяРодителя + """ для элемента """ + Наименование + """");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// У группы доступны только наименование и родитель, остальные реквизиты для неё недоступны.
		Если НЕ ТребуетсяГруппа Тогда
			ЗаполнитьРеквизиты(Объект, МетаданныеСправочника.Реквизиты, ДанныеЭлемента,
				"Наименование,Родитель,ЭтоГруппа", Итоги, Наименование);
		КонецЕсли;
		
		Объект.Записать();
		Итоги.Справочники = Итоги.Справочники + 1;
	Исключение
		Итоги.Ошибки.Добавить("Ошибка записи элемента """ + Наименование + """: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьРегистрыСведений(Данные, Итоги)
	
	Раздел = Данные.Получить("РегистрыСведений");
	Если Раздел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЭлементРаздела Из Раздел Цикл
		ИмяРегистра = ЭлементРаздела.Ключ;
		МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
		Если МетаданныеРегистра = Неопределено Тогда
			Итоги.Ошибки.Добавить("Неизвестный регистр сведений: " + ИмяРегистра);
			Продолжить;
		КонецЕсли;
		
		Для Каждого ДанныеЗаписи Из ЭлементРаздела.Значение Цикл
			ЗаписатьЗаписьРегистра(МетаданныеРегистра, ДанныеЗаписи, Итоги);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЗаписьРегистра(МетаданныеРегистра, ДанныеЗаписи, Итоги)
	
	Попытка
		НаборЗаписей = РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
		Запись = НаборЗаписей.Добавить();
		
		Период = ДанныеЗаписи.Получить("Период");
		Если ЗначениеЗаполнено(Период) Тогда
			Запись.Период = ПрочитатьДатуJSON(Период, ФорматДатыJSON.ISO);
		КонецЕсли;
		
		ЗаполнитьРеквизиты(Запись, МетаданныеРегистра.Измерения, ДанныеЗаписи, "Период", Итоги,
			МетаданныеРегистра.Имя);
		ЗаполнитьРеквизиты(Запись, МетаданныеРегистра.Ресурсы, ДанныеЗаписи, "Период", Итоги,
			МетаданныеРегистра.Имя);
		
		НаборЗаписей.Записать();
		Итоги.Регистры = Итоги.Регистры + 1;
	Исключение
		Итоги.Ошибки.Добавить("Ошибка записи в регистр " + МетаданныеРегистра.Имя + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьДокументы(Данные, Итоги)
	
	Раздел = Данные.Получить("Документы");
	Если Раздел = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Порядок важен: документы, ссылающиеся на другие документы, идут после них.
	ПорядокЗагрузки = Новый Массив;
	ПорядокЗагрузки.Добавить("Заявка");
	ПорядокЗагрузки.Добавить("ПриходНаСклад");
	ПорядокЗагрузки.Добавить("СписаниеЗапчастей");
	ПорядокЗагрузки.Добавить("ПлановоеТО");
	
	Для Каждого ИмяДокумента Из ПорядокЗагрузки Цикл
		ДокументыДанных = Раздел.Получить(ИмяДокумента);
		Если ДокументыДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МетаданныеДокумента = Метаданные.Документы.Найти(ИмяДокумента);
		Если МетаданныеДокумента = Неопределено Тогда
			Итоги.Ошибки.Добавить("Неизвестный документ: " + ИмяДокумента);
			Продолжить;
		КонецЕсли;
		
		Для Каждого ДанныеДокумента Из ДокументыДанных Цикл
			ЗаписатьДокумент(МетаданныеДокумента, ДанныеДокумента, Итоги);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьДокумент(МетаданныеДокумента, ДанныеДокумента, Итоги)
	
	Номер = ДанныеДокумента.Получить("Номер");
	ДатаДокумента = ПрочитатьДатуJSON(ДанныеДокумента.Получить("Дата"), ФорматДатыJSON.ISO);
	
	Попытка
		Менеджер = Документы[МетаданныеДокумента.Имя];
		СуществующаяСсылка = Менеджер.НайтиПоНомеру(Номер, ДатаДокумента);
		
		Если ЗначениеЗаполнено(СуществующаяСсылка) Тогда
			Объект = СуществующаяСсылка.ПолучитьОбъект();
		Иначе
			Объект = Менеджер.СоздатьДокумент();
		КонецЕсли;
		
		Объект.Дата = ДатаДокумента;
		Объект.Номер = Номер;
		
		ЗаполнитьРеквизиты(Объект, МетаданныеДокумента.Реквизиты, ДанныеДокумента, "Номер,Дата", Итоги, Номер);
		ЗаполнитьТабличнуюЧасть(Объект, МетаданныеДокумента, ДанныеДокумента, Итоги, Номер);
		
		ЗаписатьДокументСПроведением(Объект, Номер, Итоги);
		Итоги.Документы = Итоги.Документы + 1;
	Исключение
		Итоги.Ошибки.Добавить("Ошибка записи документа " + Номер + ": "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧасть(Объект, МетаданныеДокумента, ДанныеДокумента, Итоги, Контекст)
	
	ТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти("Состав");
	Если ТабличнаяЧасть = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокиДанных = ДанныеДокумента.Получить("Состав");
	Если СтрокиДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Состав.Очистить();
	
	Для Каждого ДанныеСтроки Из СтрокиДанных Цикл
		НоваяСтрока = Объект.Состав.Добавить();
		ЗаполнитьРеквизиты(НоваяСтрока, ТабличнаяЧасть.Реквизиты, ДанныеСтроки, "", Итоги, Контекст);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьДокументСПроведением(Объект, Номер, Итоги)
	
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Объект.Записать(РежимЗаписиДокумента.Запись);
		Итоги.Ошибки.Добавить("Документ " + Номер + " записан без проведения: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизиты(Приемник, КоллекцияРеквизитов, ДанныеСтроки, Исключения, Итоги, Контекст)
	
	Для Каждого ПолеДанных Из ДанныеСтроки Цикл
		ИмяПоля = ПолеДанных.Ключ;
		
		Если СтрНайти("," + Исключения + ",", "," + ИмяПоля + ",") > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Реквизит = КоллекцияРеквизитов.Найти(ИмяПоля);
		Если Реквизит = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Приемник[ИмяПоля] = ПривестиЗначение(Реквизит.Тип, ПолеДанных.Значение, Итоги, Контекст);
	КонецЦикла;
	
КонецПроцедуры

Функция ПривестиЗначение(ОписаниеТипов, Значение, Итоги, Контекст)
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Булево")) Тогда
		Возврат Булево(Значение);
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
		Возврат ПрочитатьДатуJSON(Строка(Значение), ФорматДатыJSON.ISO);
	КонецЕсли;
	
	Если ОписаниеТипов.СодержитТип(Тип("Число")) Тогда
		Возврат Число(Значение);
	КонецЕсли;
	
	СтрокаЗначения = Строка(Значение);
	
	Для Каждого ОписаниеСправочника Из Метаданные.Справочники Цикл
		Если ОписаниеТипов.СодержитТип(Тип("СправочникСсылка." + ОписаниеСправочника.Имя)) Тогда
			Ссылка = Справочники[ОписаниеСправочника.Имя].НайтиПоНаименованию(СтрокаЗначения, Истина);
			Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
				Итоги.Ошибки.Добавить("Не найден элемент """ + СтрокаЗначения + """ в справочнике "
					+ ОписаниеСправочника.Имя + " (" + Контекст + ")");
			КонецЕсли;
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеПеречисления Из Метаданные.Перечисления Цикл
		Если ОписаниеТипов.СодержитТип(Тип("ПеречислениеСсылка." + ОписаниеПеречисления.Имя)) Тогда
			Попытка
				Возврат ПредопределенноеЗначение("Перечисление." + ОписаниеПеречисления.Имя + "." + СтрокаЗначения);
			Исключение
				Итоги.Ошибки.Добавить("Неизвестное значение перечисления " + ОписаниеПеречисления.Имя
					+ "." + СтрокаЗначения + " (" + Контекст + ")");
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеДокумента Из Метаданные.Документы Цикл
		Если ОписаниеТипов.СодержитТип(Тип("ДокументСсылка." + ОписаниеДокумента.Имя)) Тогда
			Возврат Документы[ОписаниеДокумента.Имя].НайтиПоНомеру(СтрокаЗначения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти
