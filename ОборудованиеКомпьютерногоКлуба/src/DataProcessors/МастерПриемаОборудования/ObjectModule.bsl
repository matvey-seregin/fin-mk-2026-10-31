#Область ПрограммныйИнтерфейс

// Проверяет данные, введенные на шаге мастера приема оборудования.
//
// Параметры:
//  НомерШага     - Число - номер проверяемого шага (1 - оборудование, 2 - размещение,
//                  3 - приход на склад, 4 - лицензия).
//  Параметры     - Структура - данные мастера, см. функцию ПараметрыМастера в модуле формы.
//  СоставПрихода - ТаблицаЗначений - состав документа прихода на склад.
//
// Возвращаемое значение:
//  Массив из Строка - обнаруженные ошибки; пустой массив, если ошибок нет.
//
Функция ПроверитьШаг(НомерШага, Параметры, СоставПрихода) Экспорт
	
	Ошибки = Новый Массив;
	
	Если НомерШага = 1 Тогда
		
		Если Параметры.ТипОборудования = Перечисления.ВидыНоменклатуры.ПустаяСсылка() Тогда
			Ошибки.Добавить("Не указан тип оборудования.");
		КонецЕсли;
		Если ПустаяСтрока(Параметры.Модель) Тогда
			Ошибки.Добавить("Не заполнена модель оборудования.");
		КонецЕсли;
		Если ЗначениеЗаполнено(Параметры.ДатаПокупки)
			И ЗначениеЗаполнено(Параметры.ГарантияДо)
			И Параметры.ГарантияДо < Параметры.ДатаПокупки Тогда
			Ошибки.Добавить("Дата окончания гарантии не может быть раньше даты покупки.");
		КонецЕсли;
		Если Не ПустаяСтрока(Параметры.СерийныйНомер)
			И ЕстьОборудованиеССерийнымНомером(Параметры.СерийныйНомер) Тогда
			Ошибки.Добавить("Оборудование с серийным номером " + СокрЛП(Параметры.СерийныйНомер)
				+ " уже зарегистрировано.");
		КонецЕсли;
		
	ИначеЕсли НомерШага = 2 Тогда
		
		Если Параметры.РазмещатьНаРабочемМесте Тогда
			Если Параметры.РабочееМесто = Справочники.РабочиеМеста.ПустаяСсылка() Тогда
				Ошибки.Добавить("Не указано рабочее место для размещения.");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Параметры.ДатаРазмещения) Тогда
				Ошибки.Добавить("Не указана дата размещения.");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли НомерШага = 3 Тогда
		
		Если Параметры.ОформлятьПриход Тогда
			Если Параметры.КонтрагентПрихода = Справочники.Контрагенты.ПустаяСсылка() Тогда
				Ошибки.Добавить("Не указан контрагент для документа прихода.");
			КонецЕсли;
			Если Не ЕстьЗаполненныеСтрокиПрихода(СоставПрихода) Тогда
				Ошибки.Добавить("В составе прихода нет ни одной строки с номенклатурой и количеством.");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли НомерШага = 4 Тогда
		
		Если Параметры.ОформлятьЛицензию Тогда
			Если ПустаяСтрока(Параметры.ЛицензияПрограмма) Тогда
				Ошибки.Добавить("Не указана программа для лицензии.");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Параметры.ЛицензияДатаНачала)
				Или Не ЗначениеЗаполнено(Параметры.ЛицензияДатаОкончания) Тогда
				Ошибки.Добавить("Не заполнены сроки действия лицензии.");
			ИначеЕсли Параметры.ЛицензияДатаОкончания < Параметры.ЛицензияДатаНачала Тогда
				Ошибки.Добавить("Дата окончания лицензии не может быть раньше даты начала.");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

// Записывает результаты мастера приема оборудования одной транзакцией.
// При любой ошибке изменения отменяются полностью.
//
// Параметры:
//  Параметры     - Структура - данные мастера, см. функцию ПараметрыМастера в модуле формы.
//  СоставПрихода - ТаблицаЗначений - состав документа прихода на склад.
//
// Возвращаемое значение:
//  Структура - созданные объекты:
//   * Оборудование     - СправочникСсылка.Оборудование - принятая единица оборудования;
//   * ДокументПрихода  - ДокументСсылка.ПриходНаСклад, Неопределено - документ прихода,
//                        если он оформлялся;
//   * Лицензия         - СправочникСсылка.Лицензии, Неопределено - лицензия, если она заводилась.
//
Функция ПринятьОборудование(Параметры, СоставПрихода) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Результат = СоздатьРезультатыМастера(Параметры, СоставПрихода);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает объекты мастера в порядке шагов.
//
// Параметры:
//  Параметры     - Структура - данные мастера.
//  СоставПрихода - ТаблицаЗначений - состав документа прихода на склад.
//
// Возвращаемое значение:
//  Структура - созданные объекты:
//   * Оборудование     - СправочникСсылка.Оборудование - принятая единица оборудования;
//   * ДокументПрихода  - ДокументСсылка.ПриходНаСклад, Неопределено - документ прихода;
//   * Лицензия         - СправочникСсылка.Лицензии, Неопределено - лицензия.
//
Функция СоздатьРезультатыМастера(Параметры, СоставПрихода)
	
	Результат = Новый Структура;
	Результат.Вставить("Оборудование", СоздатьОборудование(Параметры));
	
	Если Параметры.РазмещатьНаРабочемМесте Тогда
		РазместитьНаРабочемМесте(Результат.Оборудование, Параметры);
	КонецЕсли;
	
	Результат.Вставить("ДокументПрихода", Неопределено);
	Если Параметры.ОформлятьПриход Тогда
		Результат.ДокументПрихода = ОформитьПриход(Параметры, СоставПрихода);
	КонецЕсли;
	
	Результат.Вставить("Лицензия", Неопределено);
	Если Параметры.ОформлятьЛицензию Тогда
		Результат.Лицензия = ОформитьЛицензию(Параметры);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Создает элемент справочника "Оборудование" по данным мастера.
//
// Параметры:
//  Параметры - Структура - данные мастера.
//
// Возвращаемое значение:
//  СправочникСсылка.Оборудование - ссылка на записанный элемент.
//
Функция СоздатьОборудование(Параметры)
	
	Оборудование = Справочники.Оборудование.СоздатьЭлемент();
	Оборудование.Наименование = СформироватьНаименованиеОборудования(Параметры);
	Оборудование.Тип = Параметры.ТипОборудования;
	Оборудование.Модель = СокрЛП(Параметры.Модель);
	Оборудование.СерийныйНомер = СокрЛП(Параметры.СерийныйНомер);
	Оборудование.ДатаПокупки = Параметры.ДатаПокупки;
	Оборудование.ГарантияДо = Параметры.ГарантияДо;
	Оборудование.Номенклатура = Параметры.Номенклатура;
	Оборудование.Комментарий = Параметры.КомментарийОборудования;
	Оборудование.Записать();
	
	Возврат Оборудование.Ссылка;
	
КонецФункции

// Записывает размещение оборудования на рабочем месте и, если требуется,
// переводит рабочее место в состояние "Занято".
//
// Параметры:
//  ОборудованиеСсылка - СправочникСсылка.Оборудование - принятая единица оборудования.
//  Параметры          - Структура - данные мастера.
//
Процедура РазместитьНаРабочемМесте(ОборудованиеСсылка, Параметры)
	
	ЗаписьРегистра = РегистрыСведений.РазмещениеОборудования.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Период = Параметры.ДатаРазмещения;
	ЗаписьРегистра.Оборудование = ОборудованиеСсылка;
	ЗаписьРегистра.РабочееМесто = Параметры.РабочееМесто;
	ЗаписьРегистра.Записать(Истина);
	
	Если Не Параметры.УстанавливатьСостояниеЗанято Тогда
		Возврат;
	КонецЕсли;
	
	РабочееМесто = Параметры.РабочееМесто.ПолучитьОбъект();
	Если РабочееМесто = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РабочееМесто.Состояние = Перечисления.СостоянияРабочегоМеста.Занято;
	РабочееМесто.Записать();
	
КонецПроцедуры

// Создает и проводит документ "Приход на склад" по составу, введенному в мастере.
//
// Параметры:
//  Параметры     - Структура - данные мастера.
//  СоставПрихода - ТаблицаЗначений - состав документа прихода на склад.
//
// Возвращаемое значение:
//  ДокументСсылка.ПриходНаСклад - ссылка на проведенный документ.
//
Функция ОформитьПриход(Параметры, СоставПрихода)
	
	Документ = Документы.ПриходНаСклад.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.ВидОперации = Параметры.ВидОперацииПрихода;
	Документ.Контрагент = Параметры.КонтрагентПрихода;
	Документ.РабочееМестоИсточник = Параметры.РабочееМестоИсточник;
	Документ.Комментарий = Параметры.КомментарийПрихода;
	
	Для Каждого СтрокаПрихода Из СоставПрихода Цикл
		
		Если СтрокаПрихода.Номенклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Документ.Состав.Добавить();
		НоваяСтрока.Номенклатура = СтрокаПрихода.Номенклатура;
		НоваяСтрока.Количество = СтрокаПрихода.Количество;
		НоваяСтрока.Цена = СтрокаПрихода.Цена;
		
	КонецЦикла;
	
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат Документ.Ссылка;
	
КонецФункции

// Создает элемент справочника "Лицензии" по данным мастера.
//
// Параметры:
//  Параметры - Структура - данные мастера.
//
// Возвращаемое значение:
//  СправочникСсылка.Лицензии - ссылка на записанный элемент.
//
Функция ОформитьЛицензию(Параметры)
	
	Лицензия = Справочники.Лицензии.СоздатьЭлемент();
	Лицензия.Наименование = СформироватьНаименованиеЛицензии(Параметры);
	Лицензия.Программа = СокрЛП(Параметры.ЛицензияПрограмма);
	Лицензия.Ключ = СокрЛП(Параметры.ЛицензияКлюч);
	Лицензия.КоличествоМест = Параметры.ЛицензияКоличествоМест;
	Лицензия.ДатаНачала = Параметры.ЛицензияДатаНачала;
	Лицензия.ДатаОкончания = Параметры.ЛицензияДатаОкончания;
	Лицензия.Контрагент = Параметры.ЛицензияКонтрагент;
	Лицензия.Стоимость = Параметры.ЛицензияСтоимость;
	Лицензия.Записать();
	
	Возврат Лицензия.Ссылка;
	
КонецФункции

// Формирует наименование единицы оборудования из модели и серийного номера.
//
// Параметры:
//  Параметры - Структура - данные мастера.
//
// Возвращаемое значение:
//  Строка - наименование оборудования.
//
Функция СформироватьНаименованиеОборудования(Параметры)
	
	ЧастиНаименования = Новый Массив;
	
	Если Не ПустаяСтрока(Параметры.Модель) Тогда
		ЧастиНаименования.Добавить(СокрЛП(Параметры.Модель));
	КонецЕсли;
	Если Не ПустаяСтрока(Параметры.СерийныйНомер) Тогда
		ЧастиНаименования.Добавить(СокрЛП(Параметры.СерийныйНомер));
	КонецЕсли;
	
	Возврат Лев(СтрСоединить(ЧастиНаименования, " "), 25);
	
КонецФункции

// Формирует наименование лицензии из названия программы и даты окончания.
//
// Параметры:
//  Параметры - Структура - данные мастера.
//
// Возвращаемое значение:
//  Строка - наименование лицензии.
//
Функция СформироватьНаименованиеЛицензии(Параметры)
	
	ДатаОкончания = "";
	Если ЗначениеЗаполнено(Параметры.ЛицензияДатаОкончания) Тогда
		ДатаОкончания = " до " + Формат(Параметры.ЛицензияДатаОкончания, "ДЛФ=D");
	КонецЕсли;
	
	Возврат Лев(СокрЛП(Параметры.ЛицензияПрограмма) + ДатаОкончания, 25);
	
КонецФункции

// Проверяет, есть ли в справочнике оборудование с указанным серийным номером.
//
// Параметры:
//  СерийныйНомер - Строка - проверяемый серийный номер.
//
// Возвращаемое значение:
//  Булево - Истина, если оборудование с таким серийным номером уже зарегистрировано.
//
Функция ЕстьОборудованиеССерийнымНомером(СерийныйНомер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Оборудование.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Оборудование КАК Оборудование
		|ГДЕ
		|	Оборудование.СерийныйНомер = &СерийныйНомер";
	Запрос.УстановитьПараметр("СерийныйНомер", СокрЛП(СерийныйНомер));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий();
	
КонецФункции

// Проверяет, есть ли в составе прихода хотя бы одна заполненная строка.
//
// Параметры:
//  СоставПрихода - ТаблицаЗначений - состав документа прихода на склад.
//
// Возвращаемое значение:
//  Булево - Истина, если есть строка с номенклатурой и положительным количеством.
//
Функция ЕстьЗаполненныеСтрокиПрихода(СоставПрихода)
	
	Для Каждого СтрокаПрихода Из СоставПрихода Цикл
		Если СтрокаПрихода.Номенклатура <> Справочники.Номенклатура.ПустаяСсылка()
			И СтрокаПрихода.Количество > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти
