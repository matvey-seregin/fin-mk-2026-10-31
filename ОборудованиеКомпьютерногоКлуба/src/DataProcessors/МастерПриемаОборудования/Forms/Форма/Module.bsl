#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДатаНачалаДня = НачалоДня(ТекущаяДатаСеанса());
	
	Шаг = 1;
	ДатаПокупки = ДатаНачалаДня;
	ДатаРазмещения = ТекущаяДатаСеанса();
	ЛицензияДатаНачала = ДатаНачалаДня;
	РазмещатьНаРабочемМесте = Истина;
	УстанавливатьСостояниеЗанято = Истина;
	
	ОбновитьСостояниеШагов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставПрихода

&НаКлиенте
Процедура СоставПриходаКоличествоПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки(Элементы.СоставПрихода.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставПриходаЦенаПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки(Элементы.СоставПрихода.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Назад(Команда)
	
	Если Шаг <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	Шаг = Шаг - 1;
	ОбновитьСостояниеШагов();
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	Если Не ПроверитьТекущийШаг() Тогда
		Возврат;
	КонецЕсли;
	
	Шаг = Шаг + 1;
	ОбновитьСостояниеШагов();
	
КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)
	
	Если ПринятьОборудованиеНаСервере() Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьТекущийШаг()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Ошибки = Обработка.ПроверитьШаг(Шаг, ПараметрыМастера(), Обработка.СоставПрихода);
	ВывестиСообщения(Ошибки);
	
	Возврат Ошибки.Количество() = 0;
	
КонецФункции

&НаСервере
Функция ПринятьОборудованиеНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Ошибки = Новый Массив;
	НомерШагаСОшибкой = 0;
	
	Для НомерШага = 1 По 4 Цикл
		
		ОшибкиШага = Обработка.ПроверитьШаг(НомерШага, ПараметрыМастера(), Обработка.СоставПрихода);
		Если ОшибкиШага.Количество() > 0 И НомерШагаСОшибкой = 0 Тогда
			НомерШагаСОшибкой = НомерШага;
		КонецЕсли;
		Для Каждого ТекстОшибки Из ОшибкиШага Цикл
			Ошибки.Добавить(ТекстОшибки);
		КонецЦикла;
		
	КонецЦикла;
	
	Если Ошибки.Количество() > 0 Тогда
		ВывестиСообщения(Ошибки);
		Шаг = НомерШагаСОшибкой;
		ОбновитьСостояниеШагов();
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		СозданныеОбъекты = Обработка.ПринятьОборудование(ПараметрыМастера(), Обработка.СоставПрихода);
	Исключение
		СообщенияОбОшибке = Новый Массив;
		СообщенияОбОшибке.Добавить("Не удалось принять оборудование: "
			+ ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВывестиСообщения(СообщенияОбОшибке);
		Возврат Ложь;
	КонецПопытки;
	
	ВывестиСообщения(ОписаниеСозданныхОбъектов(СозданныеОбъекты));
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ОписаниеСозданныхОбъектов(СозданныеОбъекты)
	
	Описание = Новый Массив;
	Описание.Добавить("Принято оборудование: " + Строка(СозданныеОбъекты.Оборудование) + ".");
	
	Если ЗначениеЗаполнено(СозданныеОбъекты.ДокументПрихода) Тогда
		Описание.Добавить("Оформлен приход на склад: " + Строка(СозданныеОбъекты.ДокументПрихода) + ".");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СозданныеОбъекты.Лицензия) Тогда
		Описание.Добавить("Заведена лицензия: " + Строка(СозданныеОбъекты.Лицензия) + ".");
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

&НаСервере
Функция ПараметрыМастера()
	
	ДанныеМастера = Новый Структура;
	ДанныеМастера.Вставить("ТипОборудования", ТипОборудования);
	ДанныеМастера.Вставить("Модель", Модель);
	ДанныеМастера.Вставить("СерийныйНомер", СерийныйНомер);
	ДанныеМастера.Вставить("ДатаПокупки", ДатаПокупки);
	ДанныеМастера.Вставить("ГарантияДо", ГарантияДо);
	ДанныеМастера.Вставить("Номенклатура", Номенклатура);
	ДанныеМастера.Вставить("КомментарийОборудования", КомментарийОборудования);
	ДанныеМастера.Вставить("РазмещатьНаРабочемМесте", РазмещатьНаРабочемМесте);
	ДанныеМастера.Вставить("РабочееМесто", РабочееМесто);
	ДанныеМастера.Вставить("ДатаРазмещения", ДатаРазмещения);
	ДанныеМастера.Вставить("УстанавливатьСостояниеЗанято", УстанавливатьСостояниеЗанято);
	ДанныеМастера.Вставить("ОформлятьПриход", ОформлятьПриход);
	ДанныеМастера.Вставить("КонтрагентПрихода", КонтрагентПрихода);
	ДанныеМастера.Вставить("ВидОперацииПрихода", ВидОперацииПрихода);
	ДанныеМастера.Вставить("РабочееМестоИсточник", РабочееМестоИсточник);
	ДанныеМастера.Вставить("КомментарийПрихода", КомментарийПрихода);
	ДанныеМастера.Вставить("ОформлятьЛицензию", ОформлятьЛицензию);
	ДанныеМастера.Вставить("ЛицензияПрограмма", ЛицензияПрограмма);
	ДанныеМастера.Вставить("ЛицензияКлюч", ЛицензияКлюч);
	ДанныеМастера.Вставить("ЛицензияКоличествоМест", ЛицензияКоличествоМест);
	ДанныеМастера.Вставить("ЛицензияДатаНачала", ЛицензияДатаНачала);
	ДанныеМастера.Вставить("ЛицензияДатаОкончания", ЛицензияДатаОкончания);
	ДанныеМастера.Вставить("ЛицензияКонтрагент", ЛицензияКонтрагент);
	ДанныеМастера.Вставить("ЛицензияСтоимость", ЛицензияСтоимость);
	
	Возврат ДанныеМастера;
	
КонецФункции

&НаСервере
Процедура ОбновитьСостояниеШагов()
	
	Элементы.СтраницыШагов.ТекущаяСтраница = СтраницаПоШагу(Шаг);
	Элементы.КнопкаНазад.Видимость = Шаг > 1;
	Элементы.КнопкаДалее.Видимость = Шаг < 4;
	Элементы.КнопкаЗавершить.Видимость = Шаг = 4;
	
КонецПроцедуры

&НаСервере
Функция СтраницаПоШагу(НомерШага)
	
	Если НомерШага = 1 Тогда
		Возврат Элементы.СтраницаОборудование;
	ИначеЕсли НомерШага = 2 Тогда
		Возврат Элементы.СтраницаРазмещение;
	ИначеЕсли НомерШага = 3 Тогда
		Возврат Элементы.СтраницаПриход;
	Иначе
		Возврат Элементы.СтраницаЛицензия;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВывестиСообщения(СписокСообщений)
	
	Для Каждого ТекстСообщения Из СписокСообщений Цикл
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = ТекстСообщения;
		СообщениеПользователю.Сообщить();
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаПрихода)
	
	Если СтрокаПрихода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПрихода.Сумма = СтрокаПрихода.Количество * СтрокаПрихода.Цена;
	
КонецПроцедуры

#КонецОбласти
