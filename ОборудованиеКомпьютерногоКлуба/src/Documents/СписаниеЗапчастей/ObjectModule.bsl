#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	ТребуемоеКоличество = Новый Соответствие;
	Для Каждого СтрокаСостава Из Состав Цикл
		Количество = ТребуемоеКоличество[СтрокаСостава.Номенклатура];
		Если Количество = Неопределено Тогда
			Количество = 0;
		КонецЕсли;
		ТребуемоеКоличество[СтрокаСостава.Номенклатура] = Количество + СтрокаСостава.Количество;
	КонецЦикла;
	
	СписокНоменклатуры = Новый Массив;
	Для Каждого ЭлементСоответствия Из ТребуемоеКоличество Цикл
		СписокНоменклатуры.Добавить(ЭлементСоответствия.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ОстаткиЗапчастейОстатки.Номенклатура КАК Номенклатура,
		|	ОстаткиЗапчастейОстатки.КоличествоОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиЗапчастей.Остатки(
		|			&МоментВремени,
		|			Номенклатура В (&СписокНоменклатуры)) КАК ОстаткиЗапчастейОстатки";
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	
	ОстаткиПоНоменклатуре = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОстаткиПоНоменклатуре[Выборка.Номенклатура] = Выборка.Остаток;
	КонецЦикла;
	
	Для Каждого ЭлементСоответствия Из ТребуемоеКоличество Цикл
		Остаток = ОстаткиПоНоменклатуре[ЭлементСоответствия.Ключ];
		Если Остаток = Неопределено Тогда
			Остаток = 0;
		КонецЕсли;
		Если Остаток < ЭлементСоответствия.Значение Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Недостаточно запчасти ""%1"": требуется %2, остаток %3",
				Строка(ЭлементСоответствия.Ключ), ЭлементСоответствия.Значение, Остаток);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ОстаткиЗапчастей.Записывать = Истина;
	
	Для Каждого СтрокаСостава Из Состав Цикл
		Движение = Движения.ОстаткиЗапчастей.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = СтрокаСостава.Номенклатура;
		Движение.Количество = СтрокаСостава.Количество;
		Движение.Сумма = СтрокаСостава.Сумма;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
